---
import { url } from '../lib/url';
import type { Artikel } from '../lib/artikel';

interface Props {
  artikel: Artikel[];
}

const { artikel } = Astro.props;
const formatiere = (d: string) =>
  new Date(d).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
---

<ul class="liste">
  {
    artikel.map((a) => (
      <li>
        <a href={url(`artikel/${a.slug}/`)}>
          <time class="datum" datetime={new Date(a.datum).toISOString().slice(0, 10)}>{formatiere(a.datum)}</time>
          <h3>{a.titel}</h3>
          <p>{a.beschreibung}</p>
          <ul class="kategorien">
            {a.kategorien.map((k) => <li>{k}</li>)}
          </ul>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .liste {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .liste > li {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: transform 0.15s ease;
  }
  .liste > li:hover { transform: translateX(4px); }
  .liste a {
    display: block;
    padding: 1.1rem 1.25rem;
    text-decoration: none;
  }
  .datum {
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--muted);
  }
  h3 {
    margin: 0.25rem 0 0.3rem;
    font-size: 1.3rem;
  }
  p {
    margin: 0;
    color: var(--muted);
  }
  .kategorien {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
  }
  .kategorien li {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
  }
</style>
