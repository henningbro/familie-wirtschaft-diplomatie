---
import { url } from '../lib/url';
import { kategorien, kategorieSlug } from '../lib/kategorien';
import { ladeArtikel } from '../lib/artikel';

interface Props {
  /** Hervorgehobene Kategorie; ohne Angabe ist „Alle“ aktiv. */
  aktiv?: string;
}

const { aktiv } = Astro.props;
// Nur Kategorien anzeigen, die mindestens einen Artikel haben
const alleArtikel = await ladeArtikel();
const vorhanden = kategorien.filter((k) => alleArtikel.some((a) => a.kategorien.includes(k)));
---

<nav aria-label="Kategorien">
  <ul class="kategorien">
    <li><a href={url()} aria-current={aktiv ? undefined : 'page'}>Alle</a></li>
    {
      vorhanden.map((k) => (
        <li>
          <a href={url(`kategorie/${kategorieSlug(k)}/`)} aria-current={k === aktiv ? 'page' : undefined}>{k}</a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .kategorien {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
  }
  a {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    background: var(--surface);
  }
  a:hover { border-color: var(--muted); }
  a[aria-current='page'] {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }
</style>
