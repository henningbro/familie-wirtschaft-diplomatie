---
import BaseLayout from './BaseLayout.astro';
import { url } from '../lib/url';

const { frontmatter } = Astro.props;
const datum = new Date(frontmatter.datum).toLocaleDateString('de-DE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={frontmatter.titel} description={frontmatter.beschreibung}>
  <article class={`kat-${frontmatter.kategorie.toLowerCase()}`}>
    <span class="kategorie">{frontmatter.kategorie}</span>
    <h1>{frontmatter.titel}</h1>
    <p class="meta">{datum}</p>
    <div class="inhalt">
      <slot />
    </div>
    <p><a href={url()}>← Alle Artikel</a></p>
  </article>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(1.8rem, 6vw, 2.6rem);
    margin: 0.3rem 0 0.4rem;
  }
  .meta {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 2rem;
  }
  .inhalt :global(p) { font-size: 1.08rem; }
  .inhalt :global(h2) { margin-top: 2.5rem; }
</style>
