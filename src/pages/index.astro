---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtikelListe from '../components/ArtikelListe.astro';
import KategorienNavi from '../components/KategorienNavi.astro';
import { ladeArtikel } from '../lib/artikel';

const artikel = await ladeArtikel();
---

<BaseLayout>
  <section class="intro">
    <p>
      Zahlen erzählen Geschichten. Hier geht es um Familien, die Wirtschaft und
      die Außenbeziehungen Deutschlands – erklärt mit Daten und Grafiken.
    </p>
  </section>

  <KategorienNavi />

  <section>
    <h2 class="ueberschrift">Neueste Artikel</h2>
    <ArtikelListe artikel={artikel} />
  </section>
</BaseLayout>

<style>
  .intro p {
    font-size: 1.15rem;
    margin: 0 0 1.5rem;
  }
  .ueberschrift {
    font-size: 1.1rem;
    font-family: var(--sans);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
</style>
